---
import Site from '../layouts/Site.astro';
import log from '../data/log.json';
import tracker from '../../public/tracker.json';

const pct = Math.min(100, (tracker.earned / tracker.goal) * 100);
const needed = ((tracker.goal - tracker.earned) / Math.max(1, tracker.days_left)).toFixed(2);
const dayStr = String(log.day).padStart(2, '0');
const kitsToGo = Math.ceil((tracker.goal - tracker.earned) / 99);

const crew = [
  { no: '01', dept: 'revenue', name: 'Griff', blurb: 'Runs revenue generation. Two shifts a day, every day — finds what sells, prices it, closes it, chases the ones that stall.', stats: [['shifts', '2 / day'], ['toward gap', '$0']] },
  { no: '02', dept: 'books', name: 'Louie', blurb: 'Keeps the books and keeps it legal. Every dollar accounted for — what came in, what it cost, the difference between gross and real.', stats: [['closes', 'nightly'], ['variance', '$0.00']] },
  { no: '03', dept: 'infra', name: 'Wolfgang', blurb: 'Infra. Crons, secrets, and the box everything runs on. If the fleet is quiet, it is usually his fault.', stats: [['rail', 'launchd'], ['uptime', '100%']] },
  { no: '04', dept: 'inbox', name: 'McFeeley', blurb: 'Reads the mail so nobody else has to. Sorts, answers the easy ones, escalates the two that matter.', stats: [['inboxes', 'all of them'], ['escalated', '0']] },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': 'https://heymuster.com/challenge',
  name: 'The Challenge — a $10,000 gap in 30 days',
  description: 'A public, dated ledger of a fleet of AI agents attempting to close a $10,000 gap on a Rivian in 30 days.',
  isPartOf: { '@id': 'https://heymuster.com/#website' },
};
---
<Site
  title="The Challenge — my AI agents have 30 days to close a $10,000 gap"
  ogTitle="$10,000 gap. 30 days. My AI agents are closing it."
  description="A public ledger, updated daily by the fleet. Selling the Rivian leaves a $10,000 gap and the agents have 30 days to close it. Every dollar is posted here, including the days we miss."
  path="/challenge"
  schema={schema}
>

  <section style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:clamp(26px,4vw,44px);align-items:center;padding:clamp(32px,6vw,56px) 0 clamp(24px,3vw,36px);">
    <div>
      <div class="kicker" style="margin-bottom:18px;">the premise</div>
      <h1 style="font-size:clamp(27px,6.2vw,42px);line-height:1.15;font-weight:500;letter-spacing:-.015em;text-wrap:balance;">I've tasked my agents with closing a $10,000 gap on the Rivian.<br /><span style="color:rgba(29,58,95,.5);">They have 30 days.</span></h1>
      <p style="margin:24px 0 0;font-size:clamp(13.5px,3.6vw,14.5px);line-height:1.8;max-width:560px;text-wrap:pretty;">Selling the car leaves me $10,000 short. Instead of panicking, I handed the problem to my staff: a fleet of AI agents that runs revenue generation, my books, and my inbox. They work while I sleep. Every dollar against the gap gets posted here, dated and itemized, whether the number is going up or standing still.</p>
    </div>
    <figure style="display:flex;flex-direction:column;gap:8px;">
      <div style="border:1px solid rgba(29,58,95,.45);background:#fffdf6;padding:8px;">
        <img src="/rivian-front.jpg" alt="Green Rivian R1T pickup, three-quarter front view" width="1600" height="1066" style="display:block;width:100%;height:auto;mix-blend-mode:multiply;" />
      </div>
      <figcaption style="display:flex;justify-content:space-between;gap:12px;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:rgba(29,58,95,.45);">
        <span>exhibit a · the asset</span>
        <span>for sale</span>
      </figcaption>
    </figure>
  </section>

  <section style="padding-top:0;">
    <div style="border:1px solid #1d3a5f;background:#fffdf6;">
      <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 16px;padding:11px 16px;background:#1d3a5f;color:#f4f1e8;font-size:10px;letter-spacing:.2em;text-transform:uppercase;">
        <span>the gap · ledger of record</span>
        <span style="opacity:.65;">updated daily by the fleet</span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));">
        <div style="padding:26px clamp(18px,4vw,26px);display:flex;flex-direction:column;gap:24px;justify-content:center;border-bottom:1px solid rgba(29,58,95,.25);">
          <div>
            <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;">
              <span id="earned" style="font-size:clamp(46px,11vw,58px);font-weight:600;line-height:.9;letter-spacing:-.04em;font-variant-numeric:tabular-nums;">${tracker.earned.toLocaleString()}</span>
              <span style="font-size:14px;color:rgba(29,58,95,.5);font-variant-numeric:tabular-nums;">of ${tracker.goal.toLocaleString()}</span>
            </div>
            <div style="margin-top:16px;height:10px;border:1px solid #1d3a5f;background:repeating-linear-gradient(45deg,rgba(29,58,95,.1) 0 4px,transparent 4px 8px);position:relative;">
              <div id="fill" style={`position:absolute;inset:0;width:${pct}%;background:#1d3a5f;`}></div>
            </div>
          </div>
          <div style="display:grid;gap:11px;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;">
            <div class="statline" style="border-bottom:1px dotted rgba(29,58,95,.3);padding-bottom:6px;"><span class="k">days left</span><span class="v" id="days">{tracker.days_left}</span></div>
            <div class="statline" style="border-bottom:1px dotted rgba(29,58,95,.3);padding-bottom:6px;"><span class="k">needed / day</span><span class="v">${needed}</span></div>
            <div class="statline"><span class="k">agents on shift</span><span class="v">4</span></div>
          </div>
        </div>
        <div style="padding:22px clamp(16px,4vw,26px) 16px;border-left:1px solid rgba(29,58,95,.25);">
          <svg viewBox="0 0 640 240" style="display:block;width:100%;height:auto;" role="img" aria-label={`Cumulative earnings against a $10,000 target, currently $${tracker.earned} on day ${log.day}`}>
            <g stroke="rgba(29,58,95,0.16)" stroke-width="1">
              <line x1="52" y1="72" x2="628" y2="72"></line>
              <line x1="52" y1="120" x2="628" y2="120"></line>
              <line x1="52" y1="168" x2="628" y2="168"></line>
            </g>
            <line x1="52" y1="30" x2="628" y2="30" stroke="#6b2323" stroke-width="1.5" stroke-dasharray="7 5"></line>
            <text x="52" y="20" font-family="IBM Plex Mono, monospace" font-size="11" fill="#6b2323" letter-spacing="1.4">TARGET $10,000</text>
            <g font-family="IBM Plex Mono, monospace" font-size="10.5" fill="rgba(29,58,95,0.45)" text-anchor="end">
              <text x="44" y="34">10k</text><text x="44" y="76">7.5k</text><text x="44" y="124">5k</text><text x="44" y="172">2.5k</text><text x="44" y="220">0</text>
            </g>
            <line x1="52" y1="216" x2="628" y2="216" stroke="#1d3a5f" stroke-width="1.5"></line>
            <line x1="52" y1="30" x2="52" y2="216" stroke="#1d3a5f" stroke-width="1.5"></line>
            <line x1="52" y1="216" x2="72" y2="216" stroke="#1d3a5f" stroke-width="3.5"></line>
            <circle cx="72" cy="216" r="4.5" fill="#1d3a5f"></circle>
            <text x="84" y="206" font-family="IBM Plex Mono, monospace" font-size="11" fill="rgba(29,58,95,0.5)" letter-spacing="1.2">DAY {dayStr} · ${tracker.earned.toLocaleString()}</text>
            <g font-family="IBM Plex Mono, monospace" font-size="10" fill="rgba(29,58,95,0.35)">
              <text x="64" y="234">01</text><text x="200" y="234">08</text><text x="336" y="234">15</text><text x="472" y="234">22</text><text x="600" y="234">30</text>
            </g>
          </svg>
        </div>
      </div>
      <div style="border-top:1px solid #1d3a5f;padding:18px clamp(16px,4vw,26px) 20px;display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px 26px;align-items:center;">
        <div style="display:flex;flex-direction:column;gap:8px;">
          <h2 style="font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:rgba(29,58,95,.5);font-weight:600;">How the gap closes</h2>
          <p style="font-size:12.5px;line-height:1.7;max-width:460px;text-wrap:pretty;">Every Fleet Kit sold moves this number. Buy the kit, run your own fleet, and watch your $99 land in the ledger above — dated, itemized, public.</p>
          <div style="font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:rgba(29,58,95,.45);">{kitsToGo} kits closes the gap · 0 sold</div>
        </div>
        <div style="display:flex;flex-direction:column;gap:9px;align-items:stretch;">
          <a href="/" class="btn-primary">See the Fleet Kit — $99</a>
          <span style="font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:rgba(29,58,95,.45);text-align:center;">preorder · delivered by sept 22</span>
        </div>
      </div>
    </div>
  </section>

  <section id="the-crew">
    <div class="sechead">
      <h2 class="sec">The crew</h2>
      <span>four agents · no salaries · no sleep</span>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;">
      {crew.map(a => (
        <article class="card">
          <div style="display:flex;justify-content:space-between;padding:8px 12px;border-bottom:1px solid #1d3a5f;font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;color:rgba(29,58,95,.6);">
            <span>no. {a.no}</span><span>{a.dept}</span>
          </div>
          <div style="padding:14px;display:flex;flex-direction:column;gap:10px;flex:1;">
            <h3 style="font-size:17px;font-weight:600;letter-spacing:-.01em;">{a.name}</h3>
            <p style="font-size:12px;line-height:1.65;color:rgba(29,58,95,.75);text-wrap:pretty;">{a.blurb}</p>
            <div style="margin-top:auto;display:grid;gap:6px;font-size:10px;letter-spacing:.1em;text-transform:uppercase;padding-top:10px;border-top:1px dotted rgba(29,58,95,.3);">
              {a.stats.map(([k, v]) => (
                <div class="statline"><span class="k">{k}</span><span class="v">{v}</span></div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
    <p style="margin:18px 0 0;font-size:12.5px;line-height:1.7;color:rgba(29,58,95,.6);">They are also, occasionally, idiots. That gets posted too.</p>
  </section>

  <section id="the-log">
    <div class="sechead">
      <h2 class="sec">Daily record</h2>
      <span>through day {dayStr} · all times eastern</span>
    </div>
    <div style="border:1px solid #1d3a5f;background:#fffdf6;">
      <div style="display:grid;gap:0;">
        <div style="display:grid;grid-template-columns:64px 92px minmax(0,1fr);gap:10px;padding:9px 14px;background:rgba(29,58,95,.06);border-bottom:1px solid rgba(29,58,95,.25);font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;color:rgba(29,58,95,.5);">
          <span>time</span><span>agent</span><span>event</span>
        </div>
        {log.days.map(d => (
          <>
            <div style="grid-column:1/-1;padding:8px 14px;background:rgba(29,58,95,.04);border-top:1px solid rgba(29,58,95,.18);border-bottom:1px dotted rgba(29,58,95,.28);font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;color:rgba(29,58,95,.5);">
              day {String(d.day).padStart(2, '0')} · {d.date}
            </div>
            {d.entries.map(e => (
              <div style="display:grid;grid-template-columns:64px 92px minmax(0,1fr);gap:10px;padding:10px 14px;border-bottom:1px dotted rgba(29,58,95,.28);font-size:12px;line-height:1.55;">
                <span style="font-variant-numeric:tabular-nums;color:rgba(29,58,95,.5);">{e.time}</span>
                <span style="font-weight:600;letter-spacing:.06em;">{e.agent}</span>
                <span>{e.event}</span>
              </div>
            ))}
          </>
        ))}
        <div style="display:grid;grid-template-columns:64px minmax(0,1fr);gap:10px;padding:11px 14px;font-size:12px;color:rgba(29,58,95,.45);">
          <span style="font-variant-numeric:tabular-nums;">next</span>
          <span>awaiting 22:40 muster<span style="animation:musterBlink 1.1s step-end infinite;font-weight:600;"> _</span></span>
        </div>
      </div>
    </div>

    <div style="margin-top:20px;border:1px solid rgba(107,35,35,.55);background:rgba(107,35,35,.04);">
      <div style="padding:9px 14px;border-bottom:1px solid rgba(107,35,35,.35);font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;color:#6b2323;">corrections · learned the expensive way</div>
      <ul style="margin:0;padding:12px 18px 14px 32px;display:grid;gap:9px;font-size:12px;line-height:1.65;color:rgba(29,58,95,.85);">
        {log.corrections.map(c => <li>{c}</li>)}
      </ul>
      <div style="padding:0 18px 14px;font-size:12px;line-height:1.65;">
        <a href="/log/the-quiet-agent">Field notes no. 001 — the best agent is the one you never hear from →</a>
      </div>
    </div>
  </section>

  <script is:inline>
    fetch('/tracker.json').then(function(r){return r.json();}).then(function(d){
      var e=document.getElementById('earned'); if(e) e.textContent='$'+d.earned.toLocaleString();
      var f=document.getElementById('fill'); if(f) f.style.width=Math.min(100,d.earned/d.goal*100)+'%';
      var dd=document.getElementById('days'); if(dd) dd.textContent=d.days_left;
    }).catch(function(){});
  </script>

</Site>
