---
import Site from '../layouts/Site.astro';
import log from '../data/log.json';
import tracker from '../../public/tracker.json';

const pct = Math.min(100, (tracker.earned / tracker.goal) * 100);
const needed = ((tracker.goal - tracker.earned) / Math.max(1, tracker.days_left)).toFixed(0);
const dayStr = String(log.day).padStart(2, '0');
const kitsToGo = Math.ceil((tracker.goal - tracker.earned) / 99);

const crew = [
  { no: '01', dept: 'Revenue', name: 'Griff', blurb: 'Finds what sells, prices it, closes it, and chases the ones that stall. Two shifts a day, every day.' },
  { no: '02', dept: 'Books', name: 'Louie', blurb: 'Keeps the books and keeps it legal. What came in, what it cost, and the difference between gross and real.' },
  { no: '03', dept: 'Infra', name: 'Wolfgang', blurb: 'Crons, secrets, and the machine everything runs on. If the fleet is quiet, it is usually his fault.' },
  { no: '04', dept: 'Inbox', name: 'McFeeley', blurb: 'Reads the mail so nobody else has to. Sorts it, answers the easy ones, escalates the two that matter.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': 'https://heymuster.com/challenge',
  name: 'The Challenge — a $10,000 gap in 30 days',
  description: 'A public, dated ledger of a fleet of AI agents attempting to close a $10,000 gap on a Rivian in 30 days.',
  isPartOf: { '@id': 'https://heymuster.com/#website' },
};
---
<Site
  title="The Challenge — my AI agents have 30 days to close a $10,000 gap"
  ogTitle="$10,000 gap. 30 days. My AI agents are closing it."
  description="A public ledger, updated daily by the fleet. Selling the Rivian leaves a $10,000 gap and the agents have 30 days to close it. Every dollar is posted here, including the days we miss."
  path="/challenge"
  schema={schema}
>

  <section style="padding-top:clamp(40px,6vw,72px);">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:clamp(30px,4.5vw,54px);align-items:center;">
      <div>
        <span class="label">The premise</span>
        <h1 style="margin-top:14px;">Closing a $10,000 gap on the Rivian in 30 days.</h1>
        <p class="lede" style="margin-top:20px;max-width:52ch;">Selling the car leaves me $10,000 short. Instead of panicking, I handed the problem to my staff.</p>
        <p class="body" style="margin-top:16px;max-width:56ch;">A fleet of AI agents runs my revenue, my books and my inbox. They work while I sleep. Every dollar against the gap is posted here, dated and itemized, whether the number is moving or standing still.</p>
      </div>
      <figure style="margin:0;">
        <div class="card" style="padding:10px;">
          <img src="/rivian-front.jpg" alt="Green Rivian R1T pickup, three-quarter front view" width="1600" height="1066" style="display:block;width:100%;height:auto;mix-blend-mode:multiply;" />
        </div>
        <figcaption style="display:flex;justify-content:space-between;gap:12px;margin-top:9px;">
          <span class="label">Exhibit A · the asset</span>
          <span class="label">For sale</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section style="padding-top:clamp(36px,5vw,52px);">
    <div class="card">
      <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:6px 18px;padding:12px 18px;background:var(--line-solid);">
        <span class="label" style="color:rgba(244,241,232,.9);">The gap · ledger of record</span>
        <span class="label" style="color:rgba(244,241,232,.55);">Updated daily by the fleet</span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));">
        <div style="padding:28px clamp(20px,4vw,28px);display:flex;flex-direction:column;gap:26px;justify-content:center;border-bottom:1px solid var(--line);">
          <div>
            <div style="display:flex;align-items:baseline;gap:11px;flex-wrap:wrap;">
              <span id="earned" class="num" style="font-size:clamp(46px,10vw,60px);font-weight:600;line-height:.9;letter-spacing:-.04em;">${tracker.earned.toLocaleString()}</span>
              <span class="num" style="font-size:15px;color:var(--ink-45);">of ${tracker.goal.toLocaleString()}</span>
            </div>
            <div style="margin-top:18px;height:12px;border:1px solid var(--line-solid);background:repeating-linear-gradient(45deg,rgba(22,40,63,.09) 0 4px,transparent 4px 8px);position:relative;">
              <div id="fill" style={`position:absolute;inset:0;width:${pct}%;background:var(--line-solid);`}></div>
            </div>
          </div>
          <div style="display:grid;gap:12px;">
            <div class="statline" style="border-bottom:1px solid var(--line);padding-bottom:9px;"><span class="k">Days left</span><span class="v" id="days">{tracker.days_left}</span></div>
            <div class="statline" style="border-bottom:1px solid var(--line);padding-bottom:9px;"><span class="k">Needed per day</span><span class="v">${needed}</span></div>
            <div class="statline"><span class="k">Agents on shift</span><span class="v">4</span></div>
          </div>
        </div>
        <div style="padding:24px clamp(18px,4vw,28px) 18px;border-left:1px solid var(--line);">
          <svg viewBox="0 0 640 240" style="display:block;width:100%;height:auto;" role="img" aria-label={`Cumulative earnings against a $10,000 target, currently $${tracker.earned} on day ${log.day} of 30`}>
            <g stroke="rgba(22,40,63,0.14)" stroke-width="1">
              <line x1="52" y1="72" x2="628" y2="72"></line>
              <line x1="52" y1="120" x2="628" y2="120"></line>
              <line x1="52" y1="168" x2="628" y2="168"></line>
            </g>
            <line x1="52" y1="30" x2="628" y2="30" stroke="#6b2323" stroke-width="1.5" stroke-dasharray="7 5"></line>
            <text x="52" y="20" font-family="IBM Plex Mono, monospace" font-size="11" fill="#6b2323" letter-spacing="1.2">TARGET $10,000</text>
            <g font-family="IBM Plex Mono, monospace" font-size="10.5" fill="rgba(22,40,63,0.42)" text-anchor="end">
              <text x="44" y="34">10k</text><text x="44" y="76">7.5k</text><text x="44" y="124">5k</text><text x="44" y="172">2.5k</text><text x="44" y="220">0</text>
            </g>
            <line x1="52" y1="216" x2="628" y2="216" stroke="#16283f" stroke-width="1.5"></line>
            <line x1="52" y1="30" x2="52" y2="216" stroke="#16283f" stroke-width="1.5"></line>
            <line x1="52" y1="216" x2="72" y2="216" stroke="#16283f" stroke-width="3.5"></line>
            <circle cx="72" cy="216" r="4.5" fill="#16283f"></circle>
            <text x="84" y="206" font-family="IBM Plex Mono, monospace" font-size="11" fill="rgba(22,40,63,0.5)" letter-spacing="1">DAY {dayStr} · ${tracker.earned.toLocaleString()}</text>
            <g font-family="IBM Plex Mono, monospace" font-size="10" fill="rgba(22,40,63,0.32)">
              <text x="64" y="234">01</text><text x="200" y="234">08</text><text x="336" y="234">15</text><text x="472" y="234">22</text><text x="600" y="234">30</text>
            </g>
          </svg>
        </div>
      </div>
      <div style="border-top:1px solid var(--line-solid);padding:22px clamp(18px,4vw,28px);display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px 32px;align-items:center;">
        <div>
          <span class="label">How the gap closes</span>
          <p class="body" style="margin-top:9px;max-width:46ch;">Every Fleet Kit sold moves this number. Buy the kit, run your own fleet, and watch your $99 land in the ledger above — dated, itemized, public.</p>
          <p class="label" style="margin-top:10px;">{kitsToGo} kits closes the gap · 0 sold</p>
        </div>
        <a href="/" class="btn btn-primary" style="display:flex;">See the Fleet Kit — $99</a>
      </div>
    </div>
  </section>

  <section id="the-crew">
    <div class="sechead">
      <span class="label">The crew</span>
      <h2>Four agents, no salaries, no sleep</h2>
      <p class="body">They are also, occasionally, idiots. That gets posted too.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(228px,1fr));gap:18px;">
      {crew.map(a => (
        <article class="card" style="display:flex;flex-direction:column;">
          <div style="display:flex;justify-content:space-between;padding:10px 14px;border-bottom:1px solid var(--line);">
            <span class="label">No. {a.no}</span><span class="label">{a.dept}</span>
          </div>
          <div style="padding:16px;">
            <h3 style="font-size:19px;">{a.name}</h3>
            <p class="body" style="margin-top:7px;">{a.blurb}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="the-log">
    <div class="sechead">
      <span class="label">Daily record · through day {dayStr}</span>
      <h2>What the fleet did, and when</h2>
      <p class="body">All times eastern. Days with nothing worth recording are left blank rather than padded.</p>
    </div>
    <div class="card">
      <div style="display:grid;grid-template-columns:70px 96px minmax(0,1fr);gap:12px;padding:11px 16px;border-bottom:1px solid var(--line-solid);background:rgba(22,40,63,.05);">
        <span class="label">Time</span><span class="label">Agent</span><span class="label">Event</span>
      </div>
      {log.days.map(d => (
        <>
          <div style="padding:10px 16px;background:rgba(22,40,63,.03);border-bottom:1px solid var(--line);">
            <span class="label">Day {String(d.day).padStart(2, '0')} · {d.date}</span>
          </div>
          {d.entries.map(e => (
            <div style="display:grid;grid-template-columns:70px 96px minmax(0,1fr);gap:12px;padding:13px 16px;border-bottom:1px solid var(--line);align-items:start;">
              <span class="num" style="font-size:12.5px;color:var(--ink-45);">{e.time}</span>
              <span class="num" style="font-size:12px;font-weight:600;">{e.agent}</span>
              <span class="body" style="font-size:14.5px;">{e.event}</span>
            </div>
          ))}
        </>
      ))}
      <div style="display:grid;grid-template-columns:70px minmax(0,1fr);gap:12px;padding:13px 16px;">
        <span class="num" style="font-size:12.5px;color:var(--ink-45);">Next</span>
        <span class="small">Awaiting the 22:40 muster</span>
      </div>
    </div>

    <div style="margin-top:22px;border:1px solid rgba(107,35,35,.5);background:rgba(107,35,35,.045);">
      <div style="padding:12px 18px;border-bottom:1px solid rgba(107,35,35,.3);">
        <span class="label" style="color:var(--accent);">Corrections · learned the expensive way</span>
      </div>
      <ul style="margin:0;padding:16px 22px 18px 38px;display:grid;gap:11px;">
        {log.corrections.map(c => <li class="body">{c}</li>)}
      </ul>
      <div style="padding:0 22px 18px;">
        <a href="/log/the-quiet-agent" class="body">Field notes no. 001 — the best agent is the one you never hear from →</a>
      </div>
    </div>
  </section>

  <script is:inline>
    fetch('/tracker.json').then(function(r){return r.json();}).then(function(d){
      var e=document.getElementById('earned'); if(e) e.textContent='$'+d.earned.toLocaleString();
      var f=document.getElementById('fill'); if(f) f.style.width=Math.min(100,d.earned/d.goal*100)+'%';
      var dd=document.getElementById('days'); if(dd) dd.textContent=d.days_left;
    }).catch(function(){});
  </script>

</Site>
