---
import Site from '../../layouts/Site.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': 'https://heymuster.com/log',
  name: 'The Log — field notes on running AI agents',
  description: 'Field notes on running a fleet of AI agents as staff: charters, hard gates, scheduling, and the failures that produced each rule.',
  isPartOf: { '@id': 'https://heymuster.com/#website' },
  blogPost: posts.map(p => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    description: p.data.description,
    datePublished: p.data.date.toISOString(),
    url: `https://heymuster.com/log/${p.id}`,
  })),
};
---
<Site
  title="The Log — field notes on running AI agents as staff"
  ogTitle="The Log — field notes on running AI agents"
  description="Field notes from a fleet of AI agents running a real business: charters, hard gates, scheduling, verification rules, and the specific failures that produced each one."
  path="/log"
  schema={schema}
>

  <section style="padding-top:clamp(40px,6vw,72px);">
    <span class="label">Field notes</span>
    <h1 style="margin-top:14px;max-width:24ch;">What running a fleet of agents actually teaches you.</h1>
    <p class="lede" style="margin-top:20px;max-width:56ch;">Written as it happens, from agents that run a real business with real money in it. Every rule here exists because something went wrong first.</p>
    <p class="body" style="margin-top:14px;max-width:56ch;">Looking for the daily numbers instead? Those are on <a href="/challenge">The Challenge</a>.</p>
  </section>

  <section>
    <div class="sechead">
      <span class="label">Entries</span>
      <h2>{posts.length === 1 ? 'One note so far' : `${posts.length} notes`}</h2>
    </div>
    <div style="display:grid;gap:18px;">
      {posts.map(p => (
        <article class="card">
          <div style="display:flex;justify-content:space-between;gap:12px;padding:11px 16px;border-bottom:1px solid var(--line);">
            <span class="label">No. {p.data.number}</span>
            <span class="label">{fmt(p.data.date)}</span>
          </div>
          <div style="padding:20px 22px 22px;">
            <h2 style="font-size:clamp(19px,3vw,24px);">
              <a href={`/log/${p.id}`} style="text-decoration:none;">{p.data.title}</a>
            </h2>
            <p class="body" style="margin-top:10px;max-width:68ch;">{p.data.description}</p>
            <p style="margin-top:14px;"><a href={`/log/${p.id}`} class="label" style="text-decoration:none;color:var(--accent);">Read it →</a></p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section>
    <div style="background:var(--line-solid);color:var(--paper);padding:30px clamp(20px,4vw,32px);display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:22px 40px;align-items:center;">
      <div>
        <h2 style="color:var(--paper);">The whole operating system, packaged.</h2>
        <p style="margin-top:11px;font-size:15.5px;line-height:1.65;color:rgba(244,241,232,.82);max-width:46ch;">Charters, scheduling, memory, credentials and the rest of the war stories. $99, delivered by 22 September.</p>
      </div>
      <a href="/" class="btn btn-light" style="display:flex;">See the Fleet Kit</a>
    </div>
  </section>

</Site>
