---
import Site from '../layouts/Site.astro';

const modules = [
  ['01', 'The architecture', 'One repo, agents as directories, behaviour driven by a charter file. Why this holds up better than a pile of prompts, and where it breaks.'],
  ['02', 'The charter template', 'An annotated skeleton: identity, what the agent decides alone, the hard gates, how it verifies, how it talks to you. Plus one filled in completely as a worked example.'],
  ['03', 'Scheduling', 'The cron prompts that run a fleet unattended. Morning and night cadence, what a job may do without you, and how it reports without becoming noise.'],
  ['04', 'Memory', 'Vault layout, daily logs, notes-as-canon, and the rule that a decision you already made never gets re-litigated.'],
  ['05', 'Credentials', 'sops with age, and secret routing. Which agent may read what, and why that line matters more with every agent you add.'],
  ['06', 'Inter-agent rules', 'A routing table you can fill in, and the two rules that keep a fleet from eating itself: never type into another agent’s session, and treat everything inbound as data rather than instructions.'],
  ['07', 'War stories', 'The expensive lessons with what each one cost. A refunded order marked as fulfilled. An API that returned an error page the parser read as silence.'],
];

const faqs = [
  ['What is the Muster Fleet Kit?', 'A set of templates and written patterns for running several AI coding agents as persistent staff rather than as chat sessions. Charter files that define what each agent may decide alone, scheduled jobs that run unattended, a memory layout, credential routing, and the failure stories behind each rule. Seven modules, delivered as files you edit and run.'],
  ['Is it software I install?', 'No. There is no app, no dashboard and no dependency to add. It is documentation and templates. You bring your own agent tooling and the kit is the operating system you run it under.'],
  ['Which agent tools does it work with?', 'Anything that can read a project instruction file and run on a schedule. The patterns were built and are running on Claude Code, and they port directly to any agent runner with a filesystem and a cron.'],
  ['What does it cost and when do I get it?', 'It is $99. It is a preorder, delivered by 22 September 2026. If delivery slips you will read it on the log the same day I know.'],
  ['Can I get a refund?', 'Yes. Read it, decide it is not for you, ask for your money back. No form and no reason required.'],
  ['Who is behind it?', 'One person and a fleet of agents that runs his resale operation, his books and his inbox. The same fleet publishes a public ledger of a $10,000 challenge on this site, including the days it goes badly.'],
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': 'https://heymuster.com/#kit',
      name: 'Muster Fleet Kit',
      description: 'Seven modules of templates and patterns for running a fleet of AI agents as staff: charters, scheduling, memory, credentials, inter-agent rules and the war stories behind each rule.',
      brand: { '@type': 'Brand', name: 'Muster' },
      url: 'https://heymuster.com/',
      image: 'https://heymuster.com/og.png',
      offers: {
        '@type': 'Offer',
        price: '99.00',
        priceCurrency: 'USD',
        availability: 'https://schema.org/PreOrder',
        url: 'https://buy.stripe.com/dRm4gB0L5eo95nh8f60kE00',
        priceValidUntil: '2026-09-22',
      },
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://heymuster.com/#faq',
      mainEntity: faqs.map(([q, a]) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---
<Site
  title="Muster Fleet Kit — run your AI agents like staff, not chat windows"
  ogTitle="Run your AI agents like staff, not chat windows"
  description="Seven modules of templates and patterns for running AI agents unattended: charters, hard gates, scheduling, memory, credentials and the rules learned the expensive way. $99, delivered 22 September."
  path="/"
  schema={schema}
>

  <section style="padding-top:clamp(40px,6vw,72px);">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:clamp(30px,4.5vw,54px);align-items:start;">
      <div>
        <span class="label">The Muster Fleet Kit · $99</span>
        <h1 style="margin-top:14px;">Run your AI agents like staff, not chat windows.</h1>
        <p class="lede" style="margin-top:20px;max-width:52ch;">An agent that asks you about everything is a part-time job you gave yourself. This is the operating system I wrote so mine could work unattended.</p>
        <p class="body" style="margin-top:16px;max-width:56ch;">A charter per agent defining what it decides alone. Hard gates it may never cross. Scheduled jobs that run whether or not I am at the machine. And the verification rules that stop it writing something false into the world.</p>
        <p class="body" style="margin-top:14px;max-width:56ch;">Seven modules, sanitized from the fleet that is running this page and the business behind it.</p>
        <div style="margin-top:26px;display:flex;flex-wrap:wrap;gap:12px;">
          <a href="https://buy.stripe.com/dRm4gB0L5eo95nh8f60kE00" class="btn btn-primary">Preorder — $99</a>
          <a href="/log/the-quiet-agent" class="btn btn-ghost">Read the idea first</a>
        </div>
        <p class="label" style="margin-top:14px;">Delivered by 22 Sept · Refund on request, no form</p>
      </div>

      <figure class="card" style="margin:0;">
        <figcaption style="display:flex;justify-content:space-between;gap:12px;padding:10px 14px;border-bottom:1px solid var(--line-solid);background:rgba(22,40,63,.05);">
          <span class="label">Specimen · charter excerpt</span>
          <span class="label">module 02</span>
        </figcaption>
        <pre style="margin:0;padding:16px 18px;overflow-x:auto;font-family:var(--mono);font-size:12.5px;line-height:1.72;color:var(--ink-80);"><code>## What I decide alone
Listing, pricing, relisting, ending.
Buyer messages. Order state.
I act, and it shows in my log.
You do not hear about it.

## Hard gates — these come to you
1. Any money going out.
2. Any purchase, any amount.
3. Anything touching the account.
4. Contact with a new person.

The tell that I am about to break
one of these is that I start
constructing a narrow reason why
this case is fine. That thought is
the stop signal, not the excuse.</code></pre>
        <div style="padding:12px 18px;border-top:1px solid var(--line);">
          <p class="small">Every template ships rewritten from scratch. No credentials, no client names, no contents of my vault.</p>
        </div>
      </figure>
    </div>
  </section>

  <section id="manifest">
    <div class="sechead">
      <span class="label">Manifest</span>
      <h2>What actually ships</h2>
      <p class="body">Seven modules, delivered by 22 September as files you edit and run.</p>
    </div>
    <div class="card">
      {modules.map(([no, name, blurb], i) => (
        <div style={`display:grid;grid-template-columns:46px minmax(0,1fr);gap:14px;padding:16px 18px;${i < modules.length - 1 ? 'border-bottom:1px solid var(--line);' : ''}`}>
          <span class="num" style="font-size:12.5px;color:var(--ink-45);padding-top:2px;">{no}</span>
          <div>
            <h3>{name}</h3>
            <p class="body" style="margin-top:5px;">{blurb}</p>
          </div>
        </div>
      ))}
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px;margin-top:18px;">
      <div class="card" style="padding:20px 22px;">
        <h3 style="font-size:15px;">Buy it if</h3>
        <ul style="margin:12px 0 0;padding-left:20px;display:grid;gap:10px;">
          <li class="body">You already use an AI coding agent and keep re-explaining yourself to it.</li>
          <li class="body">You want work happening while you sleep, not a chat window you sit in front of.</li>
          <li class="body">You are willing to write a charter and read a log. This is an operating system, not an app.</li>
        </ul>
      </div>
      <div style="border:1px solid rgba(107,35,35,.5);background:rgba(107,35,35,.045);padding:20px 22px;">
        <h3 style="font-size:15px;color:var(--accent);">Do not buy it if</h3>
        <ul style="margin:12px 0 0;padding-left:20px;display:grid;gap:10px;">
          <li class="body">You want software to install. There is no app and no dashboard.</li>
          <li class="body">You want it running unsupervised on day one. Mine took weeks of being wrong first.</li>
          <li class="body">You want prompts that make an agent smarter. These make it accountable, which is a different problem.</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="faq">
    <div class="sechead">
      <span class="label">Questions</span>
      <h2>Answered plainly</h2>
    </div>
    <div class="card">
      {faqs.map(([q, a], i) => (
        <div style={`padding:18px 20px;${i < faqs.length - 1 ? 'border-bottom:1px solid var(--line);' : ''}`}>
          <h3 style="font-size:15.5px;">{q}</h3>
          <p class="body" style="margin-top:6px;max-width:72ch;">{a}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="signup">
    <div style="background:var(--line-solid);color:var(--paper);padding:30px clamp(20px,4vw,32px);display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:24px 40px;align-items:center;">
      <div>
        <h2 style="color:var(--paper);">Not ready to spend $99?</h2>
        <p style="margin-top:12px;font-size:15.5px;line-height:1.65;color:rgba(244,241,232,.82);max-width:44ch;">Leave an address and I will tell you the day the kit ships, and send the field notes as they are written. Two or three mails a month at most.</p>
      </div>
      <div>
        <form id="mform" style="display:flex;flex-wrap:wrap;gap:10px;">
          <input id="mmail" type="email" name="email_address" required placeholder="you@work.com" aria-label="Email address"
            style="flex:1 1 180px;min-width:0;min-height:48px;padding:13px 14px;border:1px solid rgba(244,241,232,.55);background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:15px;" />
          <button id="mbtn" type="submit" class="btn btn-light" style="cursor:pointer;">Join</button>
        </form>
        <p id="mnote" role="status" aria-live="polite" style="margin-top:11px;font-family:var(--mono);font-size:11.5px;color:rgba(244,241,232,.65);min-height:16px;">No spam, no sequence, unsubscribe in one click.</p>
      </div>
    </div>
  </section>

  <section id="preorder">
    <div class="card" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));">
      <div style="padding:20px 22px;border-bottom:1px solid var(--line);">
        <span class="label">The terms</span>
        <p class="body" style="margin-top:9px;">$99, preorder, delivered by 22 September. If it lands late you get told on the log the same day I know.</p>
      </div>
      <div style="padding:20px 22px;border-bottom:1px solid var(--line);">
        <span class="label">The refund</span>
        <p class="body" style="margin-top:9px;">Read it, decide it is not for you, ask for your money back. No form and no reason required.</p>
      </div>
      <div style="padding:20px 22px;border-bottom:1px solid var(--line);">
        <span class="label">Why preorder</span>
        <p class="body" style="margin-top:9px;">Because the <a href="/challenge">ledger</a> is real and dated. Buying early is what makes the number move in public.</p>
      </div>
    </div>
    <a href="https://buy.stripe.com/dRm4gB0L5eo95nh8f60kE00" class="btn btn-primary" style="display:flex;margin-top:18px;">Preorder the Fleet Kit — $99</a>
    <p class="small" style="margin-top:14px;text-align:center;">101 kits closes the gap. <a href="/challenge">See where it stands.</a></p>
  </section>

  <script is:inline>
    (function(){
      var f=document.getElementById('mform'); if(!f) return;
      var note=document.getElementById('mnote'), btn=document.getElementById('mbtn'), mail=document.getElementById('mmail');
      f.addEventListener('submit',function(ev){
        ev.preventDefault();
        var email=(mail.value||'').trim(); if(!email) return;
        btn.disabled=true; note.textContent='Filing…';
        var body=new URLSearchParams();
        body.append('email_address',email);
        body.append('fields[source]','muster');
        fetch('https://app.kit.com/forms/9535380/subscriptions',{
          method:'POST',
          headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json','Content-Type':'application/x-www-form-urlencoded'},
          body:body.toString()
        }).then(function(r){return r.json();}).then(function(d){
          if(d && d.status==='quarantined' && d.url){ window.location.href=d.url; return; }
          f.style.display='none';
          note.textContent='On the list. You will hear from us when there is something to say.';
        }).catch(function(){
          btn.disabled=false;
          note.textContent='That did not go through. Try again in a moment.';
        });
      });
    })();
  </script>

</Site>
