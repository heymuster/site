---
import log from '../data/log.json';
import tracker from '../../public/tracker.json';
const pct = Math.min(100, (tracker.earned / tracker.goal) * 100);
const needed = ((tracker.goal - tracker.earned) / Math.max(1, tracker.days_left)).toFixed(2);
const dayStr = String(log.day).padStart(2, '0');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Muster — the log</title>
<meta name="description" content="I've tasked my AI agents with closing a $10,000 gap on the Rivian. They have 30 days. Real numbers, daily.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; margin: 0; }
  html, body { padding: 0; }
  body { background:#f4f1e8; color:#1d3a5f; font-family:"IBM Plex Mono",ui-monospace,Menlo,monospace; -webkit-font-smoothing:antialiased; }
  a { color:#1d3a5f; text-decoration:none; border-bottom:1px solid rgba(29,58,95,.3); }
  a:hover { color:#6b2323; border-bottom-color:#6b2323; }
  input { font-family:inherit; }
  @keyframes musterBlink { 0%,49%{opacity:1} 50%,100%{opacity:0} }
  .wrap { min-height:100vh; padding:0 clamp(16px,4vw,32px); overflow-x:hidden; }
  .inner { max-width:1000px; margin:0 auto; }
  header.top { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:10px 24px; padding:22px 0 12px; border-bottom:3px double #1d3a5f; }
  nav.top { display:flex; flex-wrap:wrap; gap:8px 20px; font-size:10.5px; letter-spacing:.14em; text-transform:uppercase; color:rgba(29,58,95,.55); }
  nav.top a { border:none; }
  @media (max-width:639px){ nav.top { display:none; } }
  .kicker { font-size:10.5px; letter-spacing:.22em; text-transform:uppercase; color:rgba(29,58,95,.45); }
  .card { border:1px solid #1d3a5f; background:#fffdf6; display:flex; flex-direction:column; box-shadow:3px 3px 0 rgba(29,58,95,.15); transition:transform 120ms ease, box-shadow 120ms ease; }
  .card:hover { transform:translate(-2px,-2px); box-shadow:5px 5px 0 rgba(29,58,95,.22); }
  .btn-primary { display:block; text-align:center; min-height:44px; padding:13px 18px; border:1px solid #1d3a5f; background:#1d3a5f; color:#f4f1e8; font-size:11.5px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; }
  .btn-primary:hover { background:#6b2323; border-color:#6b2323; color:#f4f1e8; }
  .statline { display:flex; justify-content:space-between; gap:10px; }
  .statline .k { color:rgba(29,58,95,.5); }
  .statline .v { font-variant-numeric:tabular-nums; font-weight:600; }
  .logrow { display:grid; grid-template-columns:64px 92px minmax(0,1fr); gap:10px; padding:10px 14px; border-bottom:1px dotted rgba(29,58,95,.28); font-size:12px; line-height:1.55; }
</style>
</head>
<body>
<div class="wrap"><div class="inner">

  <header class="top">
    <div style="display:flex;align-items:baseline;gap:14px;">
      <span style="font-size:clamp(17px,4.4vw,21px);font-weight:600;letter-spacing:.26em;text-transform:uppercase;">muster</span>
      <span style="font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:rgba(29,58,95,.5);">the log</span>
    </div>
    <nav class="top">
      <a href="#the-crew">crew</a>
      <a href="#the-log">log</a>
      <a href="#fleet-kit">fleet kit</a>
      <a href="https://x.com/heymuster" style="color:rgba(29,58,95,.35);">@heymuster</a>
    </nav>
  </header>

  <section style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:clamp(26px,4vw,44px);align-items:center;padding:clamp(32px,6vw,56px) 0 clamp(26px,4vw,40px);">
    <div>
      <div class="kicker" style="margin-bottom:18px;">entry no. 001 · the premise</div>
      <h1 style="font-size:clamp(27px,6.2vw,42px);line-height:1.15;font-weight:500;letter-spacing:-.015em;text-wrap:balance;">I've tasked my agents with closing a $10,000 gap on the Rivian.<br /><span style="color:rgba(29,58,95,.5);">They have 30 days.</span></h1>
      <p style="margin:24px 0 0;font-size:clamp(13.5px,3.6vw,14.5px);line-height:1.8;max-width:560px;text-wrap:pretty;">Selling the car leaves me $10,000 short. Instead of panicking, I handed the problem to my staff: a fleet of AI agents that runs revenue generation, my books, and my inbox. They work while I sleep. Every dollar they earn gets posted here.</p>
    </div>
    <figure style="display:flex;flex-direction:column;gap:8px;">
      <div style="border:1px solid rgba(29,58,95,.45);background:#fffdf6;padding:8px;">
        <img src="/rivian-front.jpg" alt="Green Rivian R1T, three-quarter front view" style="display:block;width:100%;height:auto;mix-blend-mode:multiply;" />
      </div>
      <figcaption style="display:flex;justify-content:space-between;gap:12px;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:rgba(29,58,95,.45);">
        <span>exhibit a · the asset</span>
        <span>for sale</span>
      </figcaption>
    </figure>
  </section>

  <section style="border:1px solid #1d3a5f;background:#fffdf6;">
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 16px;padding:11px 16px;background:#1d3a5f;color:#f4f1e8;font-size:10px;letter-spacing:.2em;text-transform:uppercase;">
      <span>the gap · ledger of record</span>
      <span style="opacity:.65;">updated daily by the fleet</span>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));">
      <div style="padding:26px clamp(18px,4vw,26px);display:flex;flex-direction:column;gap:24px;justify-content:center;border-bottom:1px solid rgba(29,58,95,.25);">
        <div>
          <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;">
            <span id="earned" style="font-size:clamp(46px,11vw,58px);font-weight:600;line-height:.9;letter-spacing:-.04em;font-variant-numeric:tabular-nums;">${tracker.earned.toLocaleString()}</span>
            <span style="font-size:14px;color:rgba(29,58,95,.5);font-variant-numeric:tabular-nums;">of ${tracker.goal.toLocaleString()}</span>
          </div>
          <div style="margin-top:16px;height:10px;border:1px solid #1d3a5f;background:repeating-linear-gradient(45deg,rgba(29,58,95,.1) 0 4px,transparent 4px 8px);position:relative;">
            <div id="fill" style={`position:absolute;inset:0;width:${pct}%;background:#1d3a5f;`}></div>
          </div>
        </div>
        <div style="display:grid;gap:11px;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;">
          <div class="statline" style="border-bottom:1px dotted rgba(29,58,95,.3);padding-bottom:6px;"><span class="k">days left</span><span class="v" id="days">{tracker.days_left}</span></div>
          <div class="statline" style="border-bottom:1px dotted rgba(29,58,95,.3);padding-bottom:6px;"><span class="k">day's take</span><span class="v">${(tracker.day_take ?? 0).toFixed ? (tracker.day_take ?? 0).toFixed(2) : '0.00'}</span></div>
          <div class="statline" style="border-bottom:1px dotted rgba(29,58,95,.3);padding-bottom:6px;"><span class="k">needed / day</span><span class="v">${needed}</span></div>
          <div class="statline"><span class="k">agents on shift</span><span class="v">4</span></div>
        </div>
      </div>
      <div style="padding:22px clamp(16px,4vw,26px) 16px;border-left:1px solid rgba(29,58,95,.25);">
        <svg viewBox="0 0 640 240" style="display:block;width:100%;height:auto;" aria-label={`Cumulative earnings, day ${log.day}`}>
          <g stroke="rgba(29,58,95,0.16)" stroke-width="1">
            <line x1="52" y1="72" x2="628" y2="72"></line>
            <line x1="52" y1="120" x2="628" y2="120"></line>
            <line x1="52" y1="168" x2="628" y2="168"></line>
          </g>
          <line x1="52" y1="30" x2="628" y2="30" stroke="#6b2323" stroke-width="1.5" stroke-dasharray="7 5"></line>
          <text x="52" y="20" font-family="IBM Plex Mono, monospace" font-size="11" fill="#6b2323" letter-spacing="1.4">TARGET $10,000</text>
          <g font-family="IBM Plex Mono, monospace" font-size="10.5" fill="rgba(29,58,95,0.45)" text-anchor="end">
            <text x="44" y="34">10k</text><text x="44" y="76">7.5k</text><text x="44" y="124">5k</text><text x="44" y="172">2.5k</text><text x="44" y="220">0</text>
          </g>
          <line x1="52" y1="216" x2="628" y2="216" stroke="#1d3a5f" stroke-width="1.5"></line>
          <line x1="52" y1="30" x2="52" y2="216" stroke="#1d3a5f" stroke-width="1.5"></line>
          <line x1="52" y1="216" x2="72" y2="216" stroke="#1d3a5f" stroke-width="3.5"></line>
          <circle cx="72" cy="216" r="4.5" fill="#1d3a5f"></circle>
          <text x="84" y="206" font-family="IBM Plex Mono, monospace" font-size="11" fill="rgba(29,58,95,0.5)" letter-spacing="1.2">DAY {dayStr} · ${tracker.earned.toLocaleString()}</text>
          <g font-family="IBM Plex Mono, monospace" font-size="10" fill="rgba(29,58,95,0.35)">
            <text x="64" y="234">01</text><text x="200" y="234">08</text><text x="336" y="234">15</text><text x="472" y="234">22</text><text x="600" y="234">30</text>
          </g>
        </svg>
      </div>
    </div>
    <div style="border-top:1px solid #1d3a5f;padding:18px clamp(16px,4vw,26px) 20px;display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px 26px;align-items:center;">
      <div style="display:flex;flex-direction:column;gap:8px;">
        <div style="font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:rgba(29,58,95,.5);">how the gap closes</div>
        <p style="font-size:12.5px;line-height:1.7;max-width:460px;text-wrap:pretty;">Every Fleet Kit sold moves this number. Buy the kit, run your own fleet, and watch your $99 land in the ledger above — dated, itemized, public.</p>
        <div style="font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:rgba(29,58,95,.45);">101 kits closes the gap · 0 sold</div>
      </div>
      <div style="display:flex;flex-direction:column;gap:9px;align-items:stretch;">
        <a href="#fleet-kit" class="btn-primary">Get the Fleet Kit — $99</a>
        <span style="font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:rgba(29,58,95,.45);text-align:center;">opens this week</span>
      </div>
    </div>
  </section>

  <section id="the-crew" style="padding:clamp(44px,7vw,64px) 0 0;">
    <div style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:6px 20px;border-bottom:1px solid rgba(29,58,95,.35);padding-bottom:10px;margin-bottom:22px;">
      <h2 style="font-size:12.5px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;">the crew</h2>
      <span style="font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:rgba(29,58,95,.45);">four agents · no salaries · no sleep</span>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;">
      {[
        {no:'01', dept:'revenue', name:'Griff', blurb:'Runs revenue generation. Works the board twice a day, every day — lists, reprices, ships, chases the ones that stall.', stats:[['shifts','2 / day'],['earned','$0']]},
        {no:'02', dept:'books', name:'Louie', blurb:'Keeps the books and keeps it legal. Every dollar accounted for — fees, shipping, refunds, the difference between gross and real.', stats:[['closes','nightly'],['variance','$0.00']]},
        {no:'03', dept:'infra', name:'Wolfgang', blurb:'Infra. Crons, secrets, and the box everything runs on. If the fleet is quiet, it is usually his fault.', stats:[['deploys today','5'],['uptime','100%']]},
        {no:'04', dept:'inbox', name:'McFeeley', blurb:'Reads the mail so nobody else has to. Sorts, answers the easy ones, escalates the two that matter.', stats:[['inboxes','all of them'],['escalated','0']]},
      ].map(a => (
        <article class="card">
          <div style="display:flex;justify-content:space-between;padding:8px 12px;border-bottom:1px solid #1d3a5f;font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;color:rgba(29,58,95,.6);">
            <span>no. {a.no}</span><span>{a.dept}</span>
          </div>
          <div style="padding:16px 14px;display:flex;flex-direction:column;gap:11px;flex:1;">
            <div style="font-size:25px;font-weight:600;letter-spacing:-.01em;">{a.name}</div>
            <div style="font-size:12.5px;line-height:1.65;color:rgba(29,58,95,.85);text-wrap:pretty;">{a.blurb}</div>
            <div style="margin-top:auto;display:grid;gap:6px;font-size:10px;letter-spacing:.1em;text-transform:uppercase;border-top:1px dotted rgba(29,58,95,.35);padding-top:10px;">
              {a.stats.map(([k,v]) => (
                <div class="statline"><span class="k">{k}</span><span class="v">{v}</span></div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
    <p style="margin:18px 0 0;font-size:12.5px;line-height:1.7;color:rgba(29,58,95,.6);">They are also, occasionally, idiots. That gets posted too.</p>
  </section>

  <section id="the-log" style="padding:clamp(44px,7vw,64px) 0 0;">
    <div style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:6px 20px;border-bottom:1px solid rgba(29,58,95,.35);padding-bottom:10px;margin-bottom:20px;">
      <h2 style="font-size:12.5px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;">the log</h2>
      <span style="font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:rgba(29,58,95,.45);">day {dayStr} · all times eastern</span>
    </div>
    <div style="border:1px solid #1d3a5f;background:#fffdf6;">
      <div style="display:grid;gap:0;">
        <div style="display:grid;grid-template-columns:64px 92px minmax(0,1fr);gap:10px;padding:9px 14px;background:rgba(29,58,95,.06);border-bottom:1px solid rgba(29,58,95,.25);font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;color:rgba(29,58,95,.5);">
          <span>time</span><span>agent</span><span>event</span>
        </div>
        {log.entries.map(e => (
          <div class="logrow">
            <span style="font-variant-numeric:tabular-nums;color:rgba(29,58,95,.5);">{e.time}</span>
            <span style="font-weight:600;letter-spacing:.06em;">{e.agent}</span>
            <span>{e.event}</span>
          </div>
        ))}
        <div style="display:grid;grid-template-columns:64px minmax(0,1fr);gap:10px;padding:11px 14px;font-size:12px;color:rgba(29,58,95,.45);">
          <span style="font-variant-numeric:tabular-nums;">next</span>
          <span>awaiting 08:23 muster<span style="animation:musterBlink 1.1s step-end infinite;font-weight:600;"> _</span></span>
        </div>
      </div>
    </div>

    <div style="margin-top:20px;border:1px solid rgba(107,35,35,.55);background:rgba(107,35,35,.04);">
      <div style="padding:9px 14px;border-bottom:1px solid rgba(107,35,35,.35);font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;color:#6b2323;">corrections · learned the expensive way</div>
      <ul style="margin:0;padding:12px 18px 14px 32px;display:grid;gap:9px;font-size:12px;line-height:1.65;color:rgba(29,58,95,.85);">
        {log.corrections.map(c => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <section id="fleet-kit" style="padding:clamp(44px,7vw,64px) 0 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;">
    <div style="border:1px solid #1d3a5f;background:#1d3a5f;color:#f4f1e8;padding:24px clamp(18px,4vw,24px);display:flex;flex-direction:column;gap:14px;">
      <div style="font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;opacity:.6;">run your own fleet</div>
      <div style="font-size:clamp(21px,5vw,26px);font-weight:600;line-height:1.2;letter-spacing:-.01em;">Muster Fleet Kit</div>
      <p style="font-size:12.5px;line-height:1.7;opacity:.85;text-wrap:pretty;">The whole operating system — agent charters, cron patterns, memory, secrets, and the rules learned the expensive way.</p>
      <div style="margin-top:auto;display:flex;flex-direction:column;gap:10px;">
        <a href="#fleet-kit" style="display:block;text-align:center;padding:13px 18px;background:#f4f1e8;color:#1d3a5f;border:none;font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;min-height:44px;">Fleet Kit — $99</a>
        <span style="font-size:10px;letter-spacing:.14em;text-transform:uppercase;opacity:.6;">opens this week</span>
      </div>
    </div>
    <div style="border:1px solid #1d3a5f;background:#fffdf6;padding:24px clamp(18px,4vw,24px);display:flex;flex-direction:column;gap:14px;">
      <div style="font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:rgba(29,58,95,.5);">go deeper</div>
      <div style="font-size:clamp(21px,5vw,26px);font-weight:600;line-height:1.2;letter-spacing:-.01em;">Run Your Fleet Like a Founder</div>
      <p style="font-size:12.5px;line-height:1.7;color:rgba(29,58,95,.85);text-wrap:pretty;">A 3-weekend live cohort: build your fleet, run it for two real weeks, come back and fix what broke. Limited seats.</p>
      <div style="margin-top:auto;display:flex;flex-wrap:wrap;gap:8px;">
        <input type="email" placeholder="you@work.com" aria-label="Email for cohort waitlist" disabled style="flex:1 1 150px;min-width:0;min-height:44px;padding:11px 12px;border:1px solid rgba(29,58,95,.4);background:#f4f1e8;color:rgba(29,58,95,.5);font-size:12.5px;" />
        <button type="button" disabled style="min-height:44px;padding:11px 18px;border:1px solid rgba(29,58,95,.4);background:rgba(29,58,95,.4);color:#f4f1e8;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;font-family:inherit;">Join</button>
      </div>
      <div style="font-size:10.5px;letter-spacing:.06em;color:rgba(29,58,95,.5);min-height:14px;">Waitlist opens this week. The fleet is busy.</div>
    </div>
  </section>

  <section style="padding:clamp(36px,6vw,52px) 0 0;">
    <figure style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;align-items:center;">
      <div style="border:1px solid rgba(29,58,95,.45);background:#fffdf6;padding:8px;">
        <img src="/rivian-rear.jpg" alt="Green Rivian R1T, rear view — taillights" style="display:block;width:100%;height:auto;mix-blend-mode:multiply;" />
      </div>
      <figcaption style="font-size:clamp(15px,3.8vw,18px);line-height:1.55;text-wrap:pretty;">Every sale moves the tracker.<br /><span style="color:rgba(29,58,95,.5);">That's the bit.</span></figcaption>
    </figure>
  </section>

  <footer style="margin-top:clamp(40px,6vw,60px);border-top:3px double #1d3a5f;padding:16px 0 28px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 20px;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:rgba(29,58,95,.55);">
    <span>Muster</span>
    <div style="display:flex;flex-wrap:wrap;gap:8px 18px;">
      <a href="https://x.com/heymuster">@heymuster</a>
      <a href="https://github.com/heymuster">github/heymuster</a>
    </div>
    <span style="color:rgba(29,58,95,.4);">a real car, a real gap, real numbers.</span>
  </footer>

</div></div>
<script>
fetch('/tracker.json').then(r=>r.json()).then(d=>{
  const e=document.getElementById('earned'); if(e) e.textContent='$'+d.earned.toLocaleString();
  const f=document.getElementById('fill'); if(f) f.style.width=Math.min(100,d.earned/d.goal*100)+'%';
  const dd=document.getElementById('days'); if(dd) dd.textContent=d.days_left;
}).catch(()=>{});
</script>
</body>
</html>
