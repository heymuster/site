---
export interface Props {
  title: string;
  description: string;
  path: string;
  ogTitle?: string;
  kicker?: string;
  schema?: unknown;
}
const { title, description, path, ogTitle, schema } = Astro.props;
const site = 'https://heymuster.com';
const canonical = site + path;
const nav = [
  { href: '/', label: 'Fleet Kit' },
  { href: '/log', label: 'The Log' },
  { href: '/challenge', label: 'The Challenge' },
];
const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': site + '/#website',
      url: site + '/',
      name: 'Muster',
      description: 'The operating system for running a fleet of AI agents, and a public ledger of what it earns.',
      publisher: { '@id': site + '/#org' },
    },
    {
      '@type': 'Organization',
      '@id': site + '/#org',
      name: 'Muster',
      url: site + '/',
      logo: site + '/og.png',
      sameAs: ['https://x.com/heymuster', 'https://github.com/heymuster'],
    },
  ],
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content="Muster">
<meta property="og:title" content={ogTitle ?? title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={site + '/og.png'}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Muster — a $10,000 gap, 30 days, ledger of record.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@heymuster">
<meta name="twitter:title" content={ogTitle ?? title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={site + '/og.png'}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<set:html value={`<script type="application/ld+json">${JSON.stringify(baseSchema)}</script>`} />
{schema && <set:html value={`<script type="application/ld+json">${JSON.stringify(schema)}</script>`} />}
<style is:global>
  * { box-sizing: border-box; margin: 0; }
  html, body { padding: 0; }
  body { background:#f4f1e8; color:#1d3a5f; font-family:"IBM Plex Mono",ui-monospace,Menlo,monospace; -webkit-font-smoothing:antialiased; }
  a { color:#1d3a5f; text-decoration:none; border-bottom:1px solid rgba(29,58,95,.3); }
  a:hover { color:#6b2323; border-bottom-color:#6b2323; }
  input { font-family:inherit; }
  @keyframes musterBlink { 0%,49%{opacity:1} 50%,100%{opacity:0} }
  .wrap { min-height:100vh; padding:0 clamp(16px,4vw,32px); overflow-x:hidden; }
  .inner { max-width:1000px; margin:0 auto; }
  .inner.narrow { max-width:680px; }
  header.top { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:10px 24px; padding:22px 0 12px; border-bottom:3px double #1d3a5f; }
  nav.top { display:flex; flex-wrap:wrap; gap:8px 22px; font-size:10.5px; letter-spacing:.14em; text-transform:uppercase; color:rgba(29,58,95,.55); }
  nav.top a { border:none; }
  nav.top a[aria-current="page"] { color:#6b2323; border-bottom:1px solid #6b2323; }
  .kicker { font-size:10.5px; letter-spacing:.22em; text-transform:uppercase; color:rgba(29,58,95,.45); }
  .card { border:1px solid #1d3a5f; background:#fffdf6; display:flex; flex-direction:column; box-shadow:3px 3px 0 rgba(29,58,95,.15); transition:transform 120ms ease, box-shadow 120ms ease; }
  .card:hover { transform:translate(-2px,-2px); box-shadow:5px 5px 0 rgba(29,58,95,.22); }
  .btn-primary { display:block; text-align:center; min-height:44px; padding:13px 18px; border:1px solid #1d3a5f; background:#1d3a5f; color:#f4f1e8; font-size:11.5px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; }
  .btn-primary:hover { background:#6b2323; border-color:#6b2323; color:#f4f1e8; }
  .btn-ghost { display:block; text-align:center; min-height:44px; padding:13px 18px; border:1px solid #1d3a5f; background:transparent; color:#1d3a5f; font-size:11.5px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; }
  .btn-ghost:hover { background:#1d3a5f; color:#f4f1e8; }
  .statline { display:flex; justify-content:space-between; gap:10px; }
  .statline .k { color:rgba(29,58,95,.5); }
  .statline .v { font-variant-numeric:tabular-nums; font-weight:600; }
  h2.sec { font-size:12.5px; font-weight:600; letter-spacing:.24em; text-transform:uppercase; }
  .sechead { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:6px 20px; border-bottom:1px solid rgba(29,58,95,.35); padding-bottom:10px; margin-bottom:20px; }
  .sechead span { font-size:10.5px; letter-spacing:.12em; text-transform:uppercase; color:rgba(29,58,95,.45); }
  section { padding:clamp(40px,6.5vw,60px) 0 0; }
</style>
</head>
<body>
<div class="wrap"><div class={Astro.props.narrow ? 'inner narrow' : 'inner'}>

  <header class="top">
    <div style="display:flex;align-items:baseline;gap:14px;">
      <a href="/" style="border:none;font-size:clamp(17px,4.4vw,21px);font-weight:600;letter-spacing:.26em;text-transform:uppercase;">muster</a>
      <span style="font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:rgba(29,58,95,.5);">run a fleet</span>
    </div>
    <nav class="top" aria-label="Primary">
      {nav.map(n => (
        <a href={n.href} aria-current={path === n.href || (n.href !== '/' && path.startsWith(n.href)) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
  </header>

  <slot />

  <footer style="margin-top:clamp(44px,6vw,64px);border-top:3px double #1d3a5f;padding:16px 0 28px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 20px;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:rgba(29,58,95,.55);">
    <span>Muster</span>
    <div style="display:flex;flex-wrap:wrap;gap:8px 18px;">
      <a href="/log">the log</a>
      <a href="/challenge">the challenge</a>
      <a href="https://x.com/heymuster">@heymuster</a>
      <a href="https://github.com/heymuster">github</a>
    </div>
    <span style="color:rgba(29,58,95,.4);">a real car, a real gap, real numbers.</span>
  </footer>

</div></div>
</body>
</html>
